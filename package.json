{
  "name": "@migor/agentia-harness",
  "version": "0.1.0",
  "description": "Agent harness 工程基座：技能资产库 + 评测台 + RSI 闭环，构建在 @migor/agentia 之上",
  "type": "module",
  "license": "MIT",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "harness": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@migor/agentia": "file:../agentia"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
